# Local mode runs with bundled fictional jade store knowledge
SHOPDESK_MODE=local
SHOPDESK_HOME=.
# Local operator console token; set a private value when deploying
SHOPDESK_ADMIN_TOKEN=local-demo-admin
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=
STRUCTURED_METHOD=function_calling
# Embeddings
EMBEDDING_BACKEND=hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
# Reranker: local | http | cross_encoder
RERANK_BACKEND=local
RERANK_URL=
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=shopdesk_jade_knowledge
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=shopdesk-ai
